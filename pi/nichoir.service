# FACULTATIF : sert seulement à lancer le programme tout seul au démarrage du Pi. Sans lui : `venv/bin/python nichoir.py` à la main.
[Unit]
Description=Nichoir mésange (capteurs, Peltier, LED, page web de test)
After=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/nichoir
Environment=NICHOIR_LAT=48.85
Environment=NICHOIR_LON=2.35
ExecStart=/home/pi/nichoir/venv/bin/python nichoir.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
